# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el ".env" real al repositorio (ya está en .gitignore).

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase
# Settings > API > JWT Settings > JWT Secret (en el panel de Supabase)
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase

# --- Base de datos (Supabase Postgres, connection string de sesión) ---
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- Pool de conexiones (opcional, tienen defaults razonables) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- CORS ---
# Dominios del frontend permitidos, separados por coma. Sin espacios extra.
CORS_ORIGINS=http://localhost:4200,https://tu-frontend.vercel.app
